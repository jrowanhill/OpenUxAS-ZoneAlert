from e3.anod.loader import spec
from e3.anod.spec import Anod
from e3.fs import cp, mkdir
import os


class GoogleTest(spec('github')):

    @property
    def build_deps(self):
        return [Anod.Dependency('compiler'),
                Anod.Dependency('cmake')]

    github_project = 'googletest'

    @Anod.primitive()
    def build(self):
        self.cmake_build(params={
            'BUILD_TESTS': 'OFF',
            'CMAKE_CXX_STANDARD': 14,
            'CMAKE_CXX_STANDARD_REQUIRED': 'ON',

            'CMAKE_INSTALL_LIBDIR': 'lib'})
        #self.adjust_pkg_config(pc_file='libgtest.pc')
        mkdir(os.path.join(self.lib_dir, 'static'))
        cp(os.path.join(self.lib_dir, 'libgtest.a'),
           os.path.join(self.lib_dir,  'static'))
