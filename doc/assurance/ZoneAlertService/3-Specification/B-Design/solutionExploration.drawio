        </mxCell>
        <mxCell id="7JNym3imKPDRWDDOxV3Q-45" value="Don&#39;t apply zone padding for Zone Alert Geometry,&lt;div&gt;it is only for routes to fly along&amp;nbsp;&lt;/div&gt;&lt;div&gt;padded polygon edges without actually&lt;/div&gt;&lt;div&gt;touching the actual zone&lt;/div&gt;" style="shape=internalStorage;whiteSpace=wrap;html=1;backgroundOutline=1;dx=20;dy=0;align=right;" vertex="1" parent="1">
          <mxGeometry x="3840" y="1181.5600000000002" width="178.75" height="90.64" as="geometry" />
        </mxCell>
        <mxCell id="7JNym3imKPDRWDDOxV3Q-63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="7JNym3imKPDRWDDOxV3Q-48" target="7JNym3imKPDRWDDOxV3Q-56">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7JNym3imKPDRWDDOxV3Q-48" value="&lt;b style=&quot;border-color: var(--border-color);&quot;&gt;Finding&lt;/b&gt;&lt;br style=&quot;border-color: var(--border-color);&quot;&gt;&lt;br&gt;&lt;div&gt;Padding is for RoutePlanner so that it can fly along zones without really touching them. It basically decides how close you should get if you want to skim edges, which route planner does.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Zone alert should not consider padding, as this would have us alerting against edge-skimming which makes no sense.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="3550" y="1117.8300000000002" width="230" height="154.37" as="geometry" />
        </mxCell>
        <mxCell id="7JNym3imKPDRWDDOxV3Q-62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7JNym3imKPDRWDDOxV3Q-49" target="7JNym3imKPDRWDDOxV3Q-56">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7JNym3imKPDRWDDOxV3Q-49" value="copying the geometry semantics of RoutePlanner use of zones, exactly, results in Zone Alerts as vehicles skim along the zone boundarie" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
